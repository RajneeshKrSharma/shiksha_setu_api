DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Addresses of the web app allowed to call the API (no trailing slash), e.g.
# CORS_ALLOWED_ORIGINS=https://your-user.github.io,http://localhost:8080
CORS_ALLOWED_ORIGINS=
# sqlite (local) | mysql (PythonAnywhere free) | postgres
# On Railway leave DB_* out: its Postgres service gives DATABASE_URL, which the app reads.
DB_ENGINE=sqlite
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
